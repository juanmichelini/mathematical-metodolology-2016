cabal-version:      2.4
name:               foundations
version:            0.1.0.0
synopsis:           Foundations for Mathematical Methodology (thesis code)
build-type:         Simple

common shared
    default-language: Haskell2010
    hs-source-dirs:   code
    build-depends:    base >=4 && <5, containers
    ghc-options:      -O1 -rtsopts

-- Prints the LaTeX for the thesis's Appendix B (First and Second Search).
executable main
    import:           shared
    main-is:          Main.hs
    other-modules:    Syntax, Util, Type, Compute, Prove, Propose, PrettyPrint

-- Runs the lemma-proving suite in Test.hs (provelemas 30).
executable test-lemmas
    import:           shared
    main-is:          Test.hs
    other-modules:    Syntax, Util, Type, Compute, Prove, Propose, PrettyPrint
    ghc-options:      -main-is Test

-- Reports which lemmas in Test.lemas the tactics prove; exits 1 if any is unproved.
executable check-lemmas
    import:           shared
    main-is:          CheckLemmas.hs
    other-modules:    Test, Syntax, Util, Type, Compute, Prove, Propose, PrettyPrint
